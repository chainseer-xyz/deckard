# syntax=docker/dockerfile:1.7
# Retain the official CLI's bundled frameworks, debug shell and nonroot runtime.
# Replace only its executable with the exact release source and reviewed fixes.
FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS scanner
ARG TARGETOS
ARG TARGETARCH
ARG KUBESCAPE_VERSION=v4.0.16
ARG KUBESCAPE_COMMIT=d0ea07bcd9d7ab1640dcd6527d0e68a34f10da0e
SHELL ["/bin/ash", "-eo", "pipefail", "-c"]
RUN apk add --no-cache git
WORKDIR /src
RUN git clone --depth 1 --branch ${KUBESCAPE_VERSION} https://github.com/kubescape/kubescape.git . \
 && test "$(git rev-parse HEAD)" = "${KUBESCAPE_COMMIT}"
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go get golang.org/x/image@v0.45.0 golang.org/x/net@v0.60.0 \
 && go mod tidy \
 && go mod verify \
 && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -mod=readonly -trimpath \
      -ldflags="-s -w -X main.version=${KUBESCAPE_VERSION} -X main.commit=${KUBESCAPE_COMMIT}" -o /out/kubescape .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /out/licenses/kubescape \
 && cp LICENSE /out/licenses/kubescape/LICENSE \
 && cp /usr/local/go/LICENSE /out/licenses/kubescape/Go-LICENSE \
 && CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go list -mod=readonly -deps -f '{{with .Module}}{{if .Replace}}{{.Replace.Path}}|{{.Replace.Version}}|{{.Replace.Dir}}{{else}}{{.Path}}|{{.Version}}|{{.Dir}}{{end}}{{end}}' . | sort -u > /tmp/kubescape-modules \
 && while IFS='|' read -r module module_version module_dir; do \
      test -n "$module" || continue; \
      destination="/out/licenses/kubescape/dependencies/$(printf '%s@%s' "$module" "$module_version" | tr '/' '_')"; \
      mkdir -p "$destination"; \
      find "$module_dir" -maxdepth 1 -type f \( -iname 'licen[cs]e*' -o -iname 'notice*' -o -iname 'copying*' -o -iname 'copyright*' \) -exec cp '{}' "$destination/" \; ; \
      if test -z "$(find "$destination" -type f -print -quit)"; then \
        for readme in "$module_dir"/README* "$module_dir"/readme*; do \
          test -f "$readme" || continue; \
          if grep -Eiq 'licen[cs]e|copyright' "$readme"; then cp "$readme" "$destination/"; fi; \
        done; \
      fi; \
      test -n "$(find "$destination" -type f -print -quit)" || { printf 'missing license notice for %s@%s\n' "$module" "$module_version" >&2; exit 1; }; \
      printf '%s@%s\n' "$module" "$module_version" >> /out/licenses/kubescape/DEPENDENCIES.txt; \
    done < /tmp/kubescape-modules

FROM quay.io/kubescape/kubescape-cli:v4.0.16@sha256:d575d4f2281473ce539d41053d63482a4e9e07f35d987206b2bac79b2c9ad4bc
COPY --from=scanner /out/kubescape /usr/bin/kubescape
COPY --from=scanner /out/licenses/kubescape /usr/share/licenses/kubescape
LABEL org.opencontainers.image.licenses="Apache-2.0" \
      io.deckard.kubescape.source.revision="d0ea07bcd9d7ab1640dcd6527d0e68a34f10da0e"
USER 65532:65532
ENTRYPOINT ["kubescape"]
