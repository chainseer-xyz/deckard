# syntax=docker/dockerfile:1.7
ARG DECKARD_IMAGE
FROM ${DECKARD_IMAGE} AS deckard

# Official Trivy 0.76.1 includes the patched Go standard library.
# No Docker socket, host filesystem or cloud identity.
FROM ghcr.io/aquasecurity/trivy:0.76.1@sha256:790fd66d1697395d8693d1acaa1ea702406a20f109b6fc7bac8db623eca6c06c
# Retain explicit security floors without a broad OS upgrade.
RUN apk add --no-cache --upgrade 'libexpat>=2.9.0-r0' 'brotli-libs>=1.2.1-r0'
COPY --from=deckard /usr/local/bin/deckard /usr/local/bin/deckard
ENV HOME=/tmp \
    TRIVY_CACHE_DIR=/tmp/trivy \
    AWS_EC2_METADATA_DISABLED=true
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/deckard"]
