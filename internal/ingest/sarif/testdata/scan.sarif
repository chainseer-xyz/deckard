{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "semanticVersion": "1.90.0",
          "rules": [
            {
              "id": "python.lang.security.audit.eval-detected.eval-detected",
              "name": "python.lang.security.audit.eval-detected.eval-detected",
              "shortDescription": {"text": "Semgrep Finding: python.lang.security.audit.eval-detected.eval-detected"},
              "fullDescription": {"text": "Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content."},
              "help": {"text": "Avoid eval(); parse the input with ast.literal_eval or a real parser instead.", "markdown": "Avoid `eval()`."},
              "helpUri": "https://semgrep.dev/r/python.lang.security.audit.eval-detected.eval-detected",
              "defaultConfiguration": {"level": "warning"},
              "properties": {"precision": "very-high", "security-severity": "8.1", "tags": ["CWE-95: Eval Injection", "OWASP-A03:2021 - Injection", "security"]}
            },
            {
              "id": "yaml.github-actions.security.run-shell-injection.run-shell-injection",
              "shortDescription": {"text": "Possible shell injection in a GitHub Actions run step"},
              "helpUri": "https://semgrep.dev/r/yaml.github-actions.security.run-shell-injection.run-shell-injection",
              "defaultConfiguration": {"level": "error"},
              "messageStrings": {"default": {"text": "Using {0} directly in a run step allows shell injection; pass it through an environment variable."}},
              "properties": {"tags": ["CWE-78"]}
            }
          ]
        }
      },
      "versionControlProvenance": [{"repositoryUri": "https://ci:fake-token-in-uri@github.com/example/app.git", "revisionId": "4e5f60718293a4b5c6d7e8f9012345670a1b2c3d", "branch": "main"}],
      "results": [
        {
          "ruleId": "python.lang.security.audit.eval-detected.eval-detected",
          "ruleIndex": 0,
          "message": {"text": "Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/api/handlers.py", "uriBaseId": "%SRCROOT%"}, "region": {"startLine": 42, "startColumn": 12, "snippet": {"text": "return eval(expr)"}}}}],
          "partialFingerprints": {"primaryLocationLineHash": "3f2a1b0c9d8e7f60:1"},
          "baselineState": "new"
        },
        {
          "ruleId": "yaml.github-actions.security.run-shell-injection.run-shell-injection",
          "ruleIndex": 1,
          "message": {"id": "default", "arguments": ["${{ github.event.pull_request.title }}"]},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": ".github/workflows/triage.yml"}, "region": {"startLine": 18}}}],
          "fingerprints": {"matchBasedId/v1": "a1b2c3d4"}
        },
        {
          "ruleId": "python.lang.security.audit.eval-detected.eval-detected",
          "ruleIndex": 0,
          "message": {"text": "Detected the use of eval()."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "tools/repl.py"}, "region": {"startLine": 7}}}],
          "suppressions": [{"kind": "inSource", "status": "accepted", "justification": "developer tool"}]
        },
        {
          "ruleId": "python.lang.security.audit.eval-detected.eval-detected",
          "message": {"text": "Detected the use of eval()."},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "src/old.py"}, "region": {"startLine": 3}}}],
          "baselineState": "absent"
        },
        {
          "ruleId": "python.lang.security.audit.eval-detected.eval-detected",
          "kind": "pass",
          "message": {"text": "No eval in src/ok.py"}
        }
      ]
    },
    {
      "tool": {
        "driver": {"name": "Trivy", "version": "0.56.0", "informationUri": "https://github.com/aquasecurity/trivy", "rules": []},
        "extensions": [{"name": "trivy-db", "rules": [{"id": "CVE-2024-24790", "shortDescription": {"text": "golang: net/netip: Unexpected behavior from Is methods for IPv4-mapped IPv6 addresses"}, "help": {"text": "Upgrade the Go toolchain to 1.22.4 or later."}, "properties": {"security-severity": 9.8, "tags": ["vulnerability", "CRITICAL"]}}]}]
      },
      "results": [
        {
          "ruleId": "CVE-2024-24790",
          "level": "error",
          "message": {"text": "Package: stdlib\nInstalled Version: 1.22.1\nFixed Version: 1.22.4"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "usr/local/bin/app"}, "region": {"startLine": 1}}}]
        },
        {
          "ruleId": "no-rule-defined",
          "level": "note",
          "message": {"text": "Informational result without a rule"}
        }
      ]
    }
  ]
