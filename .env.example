# Copy to .env (never commit .env). Both secrets below are REQUIRED: compose
# refuses to start without them.
# Bearer token for the API, at least 32 bytes:  openssl rand -hex 32
DECKARD_ADMIN_TOKEN=
# Postgres password (no default):               openssl rand -hex 24
POSTGRES_PASSWORD=
# Cloudflare API token, read-only: Zone:Read, DNS:Read, Load Balancers:Read, Account Settings:Read, Cloudflare Tunnel:Read
CF_API_TOKEN=
